# Node modules (if any)
node_modules/

# Build artifacts (but allow dist/js/bundle-auth.js and bundle-pdf-handler.js)
dist/*
!dist/js/
dist/js/*
!dist/js/bundle-auth.js
!dist/js/bundle-auth.js.map
!dist/js/bundle-pdf-handler.js
!dist/js/bundle-pdf-handler.js.map
build/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Log files
*.log

# Sensitive configuration
# Note: clerk-config.js is now tracked with a default test key
# Users can override it locally for production deployment
.env
.env.local
verify-fix.js

# Test artifacts
test-results/
playwright-report/
test-report.json
patch.diff
# Allow test result screenshots
!test-results/*.png
test-results/
