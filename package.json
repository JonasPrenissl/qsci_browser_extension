{
  "name": "qsci-browser-extension",
  "version": "12.0.0",
  "description": "Q-SCI: Scientific Paper Quality Evaluator Browser Extension",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "build:watch": "node build.js --watch",
    "reload:server": "node tools/reloader.mjs",
    "dev": "npm-run-all -p build:watch reload:server",
    "test-server": "node test-server.js",
    "verify": "node verify-auth-redirect.js",
    "mock-backend": "node mock-backend-server.js",
    "smoke-test": "node smoke-test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "chokidar": "^3.6.0",
    "esbuild": "^0.19.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.0.0"
  }
}
